# Copy this file to .env and fill in your key. .env is gitignored — never commit real keys.

# Required. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 (good quality/cost balance for this app).
# Use claude-opus-5 for higher-quality writing if you don't mind ~5x the token cost.
CLAUDE_MODEL=claude-sonnet-5

# Reserved for Phase 3/4 (hashtag web research + image vision). Not used yet.
# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

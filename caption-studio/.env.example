# Copy this file to .env and fill in your key. .env is gitignored — never commit real keys.

# Required. Free-tier key, get one at https://aistudio.google.com/apikey
# The whole app (style guide, captions, hashtag research, image analysis) runs
# on this single free-tier key — no paid API is used anywhere.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Optional. Local UI server port (npm start). Defaults to 3000.
PORT=3000
